PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_book_locker_jwt_key_2026
FRONTEND_URL=http://localhost:5173

# Database configuration
# Default uses local SQLite for instant zero-config setup.
# For PostgreSQL (Docker/Production): DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booklocker?schema=public"
DATABASE_URL="file:./dev.db"

# MQTT Broker Configuration
# By default, EMBEDDED_MQTT=true runs a built-in MQTT broker on port 1883 so you don't need to install Mosquitto!
# Set EMBEDDED_MQTT=false to connect to an external broker like mqtt://localhost:1883 or mqtt://broker.emqx.io
EMBEDDED_MQTT=true
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_PORT=1883
